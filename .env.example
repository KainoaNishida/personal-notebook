# Public browser configuration. Never place a service-role or AI key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Public owner identifier for the password-only sign-in screen; never a password.
VITE_OWNER_EMAIL=
# Local sample preview only. Production builds ignore this setting.
VITE_DEMO_MODE=false
